<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_metro_logo"
        android:roundIcon="@drawable/ic_metro_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NammaMetro">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.NammaMetro.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".RouteActivity" android:exported="false" />
        <activity android:name=".StepperActivity" android:exported="false" />
        <activity android:name=".ExitFinderActivity" android:exported="false" />
        <activity android:name=".TokenMachineActivity" android:exported="false" />
    </application>
</manifest>
